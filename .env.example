# Plumbus environment template
# Copy to .env and replace every CHANGE_ME value before production deployment.

APP_ENV=production
APP_URL=https://cinema.example.com
HTTP_PORT=8080

POSTGRES_DB=cinema
POSTGRES_USER=cinema
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_DATABASE_PASSWORD
DATABASE_URL=postgresql+psycopg://cinema:CHANGE_ME_LONG_RANDOM_DATABASE_PASSWORD@postgres:5432/cinema
REDIS_URL=redis://redis:6379/0

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://cinema.example.com/api/auth/discord/callback
INITIAL_SUPERADMIN_DISCORD_ID=

# If Plex runs on the same Docker host, host.docker.internal works on Linux via extra_hosts.
# Otherwise set this to the LAN/VPN-reachable Plex URL, e.g. http://192.168.1.100:32400
PLEX_URL=http://host.docker.internal:32400
PLEX_TOKEN=
PLEX_SCAN_INTERVAL_MINUTES=30

SESSION_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_BYTES
TOKEN_ENCRYPTION_KEY=CHANGE_ME_AT_LEAST_32_RANDOM_BYTES
PLAYBACK_TOKEN_LIFETIME_MINUTES=360
COOKIE_SECURE=true

# Comma-separated hosts/origins. Include the public hostname used in APP_URL.
TRUSTED_HOSTS=cinema.example.com,localhost,127.0.0.1
CORS_ORIGINS=https://cinema.example.com

# Never enable mock Plex in production.
MOCK_PLEX=false

# Optional tuning
WEB_CONCURRENCY=4
GUNICORN_TIMEOUT=120
CELERY_CONCURRENCY=2
CELERY_LOG_LEVEL=INFO
