# Plumbus infrastructure bootstrap template
# Recommended: run ./install.sh and let it create .env automatically.
# Discord and Plex account/server configuration are completed in the /setup web wizard.

APP_ENV=production
APP_URL=http://localhost:8080
HTTP_PORT=8080

POSTGRES_DB=cinema
POSTGRES_USER=cinema
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_DATABASE_PASSWORD
DATABASE_URL=postgresql+psycopg://cinema:CHANGE_ME_LONG_RANDOM_DATABASE_PASSWORD@postgres:5432/cinema
REDIS_URL=redis://redis:6379/0

# These protect Plumbus sessions and encrypted integration credentials.
# Keep them stable across restarts and backups.
SESSION_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_BYTES
TOKEN_ENCRYPTION_KEY=CHANGE_ME_AT_LEAST_32_RANDOM_BYTES

# Background scan cadence and playback token lifetime are safe infrastructure defaults.
PLEX_SCAN_INTERVAL_MINUTES=30
PLAYBACK_TOKEN_LIFETIME_MINUTES=360

# The wizard stores the real public site URL and derives secure session cookies from HTTPS.
# Keep this true for production; first-run setup uses a separate one-time claim cookie.
COOKIE_SECURE=true

# Same-origin requests are accepted dynamically. Add values only if a separate frontend origin is required.
CORS_ORIGINS=http://localhost:8080

MOCK_PLEX=false

# Optional tuning
WEB_CONCURRENCY=4
GUNICORN_TIMEOUT=120
CELERY_CONCURRENCY=2
CELERY_LOG_LEVEL=INFO
