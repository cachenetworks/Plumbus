# Plumbus Dockge environment
# Paste these into Dockge's Environment section or save as .env for the stack.

HTTP_PORT=8080
APP_URL=http://localhost:8080

POSTGRES_DB=cinema
POSTGRES_USER=cinema
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_DATABASE_PASSWORD

# Generate each independently with: openssl rand -base64 48
SESSION_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS
TOKEN_ENCRYPTION_KEY=CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS

# Optional runtime tuning
PLEX_SCAN_INTERVAL_MINUTES=30
PLAYBACK_TOKEN_LIFETIME_MINUTES=360
WEB_CONCURRENCY=4
GUNICORN_TIMEOUT=120
CELERY_CONCURRENCY=2
CELERY_LOG_LEVEL=INFO

# The setup wizard saves the real public site URL and integration settings in PostgreSQL.
TRUSTED_HOSTS=localhost,127.0.0.1
CORS_ORIGINS=http://localhost:8080
